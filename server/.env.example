# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" a un repositorio publico.

# Puerto en el que arranca el servidor
PORT=3000

# Cuenta de Gmail que ENVIA los correos (puede ser la misma del restaurante)
GMAIL_USER=restaurantelaruedachulilla@gmail.com

# Contrasena de aplicacion de Gmail (NO es la contrasena normal de la cuenta).
# Se genera en: https://myaccount.google.com/apppasswords
# (requiere tener la verificacion en dos pasos activada en esa cuenta de Gmail)
GMAIL_APP_PASSWORD=

# Direccion donde llegan las notificaciones de reserva
RESTAURANT_EMAIL=restaurantelaruedachulilla@gmail.com

# Contrasena para entrar al panel de administracion (/admin.html)
ADMIN_PASSWORD=cambia-esta-contrasena

# Aviso automatico por WhatsApp de cada reserva (via CallMeBot, gratis).
# Pasos: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# CALLMEBOT_PHONE es el numero de WhatsApp del restaurante en formato internacional sin "+" ni espacios (ej: 34613727680)
# CALLMEBOT_APIKEY es el codigo que te da CallMeBot al activarlo
CALLMEBOT_PHONE=34613727680
CALLMEBOT_APIKEY=
